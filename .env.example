# =====================
# Telegram
# =====================
BOT_TOKEN=replace_at_deploy
ADMIN_IDS=123456789
TZ=Europe/Moscow

# =====================
# Database
# По умолчанию SQLite. Для production:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/booking
# =====================
DATABASE_URL=sqlite+aiosqlite:///./data/booking.db

# =====================
# FSM Storage (memory|redis)
# =====================
FSM_BACKEND=memory
REDIS_URL=

# =====================
# Scheduler (минуты)
# =====================
REMINDER_OFFSET_24H_MIN=1440
REMINDER_OFFSET_2H_MIN=120
ROLLING_HOUR_LOCAL=3

# =====================
# AI / NLU / Voice (Groq)
# =====================
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_WHISPER_MODEL=whisper-large-v3
# OLLAMA_MODEL=qwen2.5:14b
ENABLE_NLU=true
ENABLE_VOICE=true
AUTO_SEED_DEMO=true

# Salon FAQ (короткие ответы без LLM-галлюцинаций)
SALON_BRANDS=OPI, Gelish, Artistic Nail Design
PETS_ALLOWED=false

# Дневной лимит (anti-abuse): 100 сообщений/день, 3 нарушения → блок до /unblock
ENABLE_USAGE_LIMIT=true
DAILY_MSG_LIMIT=100
DAILY_MSG_STRIKES_BEFORE_BLOCK=3
SALON_ADMIN_CONTACT=@your_salon
# Промокод в ответе на жалобу (опционально)
SALON_RECOVERY_PROMO=

# =====================
# Logging / observability
# =====================
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOG_FILE_MAX_MB=10
HEARTBEAT_INTERVAL_SEC=30
WATCHDOG_MAX_STALE_SEC=120
